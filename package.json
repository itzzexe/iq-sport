{
  "name": "iq-sports-group",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "مجموعة العراق الرياضية — IQ Sports Group website + Payload CMS",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/heal-dev-cache.ts && cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/migrate.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:clean": "cross-env NODE_OPTIONS=--no-deprecation node -e \"require('fs').rmSync('.next/dev',{recursive:true,force:true})\" && npm run dev",
    "prebuild": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/migrate.ts && cross-env NODE_OPTIONS=--no-deprecation tsx src/payload/seed/run.ts",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6144\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/migrate.ts",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/migrate-create.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/payload/seed/run.ts",
    "seed:reset": "cross-env NODE_OPTIONS=--no-deprecation tsx src/payload/seed/run.ts --reset"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.89.0",
    "@payloadcms/live-preview-react": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/plugin-seo": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-vercel-blob": "^3.89.0",
    "@payloadcms/translations": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "@react-three/fiber": "^9.7.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.3",
    "payload": "3.89.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.176.0",
    "tailwindcss": "^4.1.18",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  }
}
