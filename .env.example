# ---------------------------------------------------------------------------
# مجموعة العراق الرياضية — environment
# انسخ هذا الملف إلى .env وعدّل القيم
# ---------------------------------------------------------------------------

# قاعدة البيانات (SQLite ملف محلي — لا يحتاج أي خادم).
# على Vercel أو أي منصة بلا قرص دائم: Turso/libSQL —
#   DATABASE_URL=libsql://xxx.turso.io  و  DATABASE_AUTH_TOKEN=...
#   (تكامل Turso في Vercel Marketplace يضيف TURSO_DATABASE_URL / TURSO_AUTH_TOKEN وهما مقبولان أيضاً)
DATABASE_URL=file:./data/iq-sport.db
DATABASE_AUTH_TOKEN=

# الصور: محلياً تُحفظ في public/media. على Vercel اربط مخزن Blob بالمشروع
# (Storage ← Create ← Blob ← Connect Project) فيُضاف هذا المتغير تلقائياً ويُفعَّل الرفع إلى Blob.
# BLOB_READ_WRITE_TOKEN=

# مفتاح تشفير الجلسات — أنشئ قيمة عشوائية طويلة (32+ حرفاً) ولا تشاركها
PAYLOAD_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# رابط الموقع العام بدون شرطة مائلة في النهاية (يُستخدم في canonical / sitemap / OpenGraph)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# سرّ المعاينة الحية من لوحة التحكم
PREVIEW_SECRET=CHANGE_ME_TOO

# تعطيل التعبئة التلقائية للمحتوى الأولي عند أول تشغيل (افتراضياً مفعّلة)
# PAYLOAD_SEED=false
